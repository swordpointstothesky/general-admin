    public async Task<bool> UpdateAsync({{ PkType }} id, Update{{ ModuleName }}Request request)
    {
        var entity = await _context.{{ ModuleName }}s.FindAsync(id);
        if (entity == null) return false;

{{~ for col in FormColumns ~}}
{{~ if col.CSharpType == "string" || col.CSharpType == "string?" ~}}
        if (!string.IsNullOrEmpty(request.{{ col.ColumnName }}))
            entity.{{ col.ColumnName }} = request.{{ col.ColumnName }};
