        var entity = new {{ ModuleName }}
        {
{{~ for col in FormColumns ~}}
            {{ col.ColumnName }} = request.{{ col.ColumnName }},
{{~ end ~}}
        };

        _context.{{ ModuleName }}s.Add(entity);
